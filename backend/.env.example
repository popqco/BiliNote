
# 通用
ENV=production
API_BASE_URL=http://127.0.0.1:8000
SCREENSHOT_BASE_URL=http://127.0.0.1:8000/static/screenshots
STATIC=/static # 外部访问路径（URL 前缀）
OUT_DIR=./static/screenshots    # 本地输出目录
IMAGE_BASE_URL=/static/screenshots  # 图片访问 URL
DATA_DIR=data
# transcriber 相关配置
TRANSCRIBER_TYPE=fast-whisper # fast-whisper/bcut/kuaishou
WHISPER_MODEL_SIZE=base

# ---- 视频理解喂图（2026-10-11 起可配；默认值适合大上下文视觉模型）----
# 抽帧总数 / 拼图数量预算：超出时自动拉大采样间隔（必要时升 3×3 拼图）。
# 旧默认 600/150；免费额度紧张可设回 600/150
#FRAME_BUDGET=2400
#IMAGE_BUDGET=500
# 喂图策略：segmented=时间对齐分批（默认，每批转写+对应截图，批内≤20张拼图）
#            single=旧的按字节分块（图多时溢出成无文本纯图块）
#SUMMARY_FEED_STRATEGY=segmented
# 总结降级阶梯总死线：基础 1500s，每多一个批次 +240s（设 0 关闭放宽）
#SUMMARIZE_LADDER_DEADLINE_PER_CHUNK=240

# ---- 模型请求护栏（既有项，一并注明）----
# 单次请求体字节上限 / 单请求拼图张数上限（分批按此切）
#OPENAI_MAX_REQUEST_BYTES=47185920
#OPENAI_MAX_IMAGES_PER_REQUEST=20